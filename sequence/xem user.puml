@startuml view_user_sequence
title Sequence Diagram - View User Flow

actor Admin
boundary "UserPage" as UI <<boundary>>
control UserController
control UserService
control UserRepository
database DB

' ===== Xem danh sách user =====
Admin -> UI: Xem danh sách User
UI -> UserController: Xem danh sách User

UserController -> UserService: Lấy danh sách user

UserService -> UserRepository: Query users
UserRepository -> DB: SELECT users
DB --> UserRepository: user list
UserRepository --> UserService: return list
UserService --> UserController: return list

UserController --> UI: danh sách user

' ===== Xem chi tiết =====
Admin -> UI: Xem chi tiết User
UI -> UserController: Xem chi tiết User

UserController -> UserService: Lấy chi tiết user

UserService -> UserRepository: Query user
UserRepository -> DB: SELECT user
DB --> UserRepository: user data
UserRepository --> UserService: return data
UserService --> UserController: return data

UserController --> UI: thông tin user

@enduml