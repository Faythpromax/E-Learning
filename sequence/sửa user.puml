@startuml update_user_sequence
title Sequence Diagram - Update User Flow

actor Admin
boundary "UpdateUserPage" as UI <<boundary>>
control UserController
control UserRequest
control UserService
control UserRepository
database DB

Admin -> UI: Sửa thông tin User
UI -> UserController: Sửa thông tin User

UserController -> UserRequest: Validate dữ liệu

alt Dữ liệu không hợp lệ
    UserRequest --> UserController: Error
    UserController --> UI: Thông báo lỗi
else Hợp lệ
    UserController -> UserService: Cập nhật User

    UserService -> UserRepository: Kiểm tra tồn tại
    UserRepository -> DB: SELECT user
    DB --> UserRepository: user data

    alt Không tồn tại
        UserRepository --> UserService: Error (not found)
        UserService --> UserController: Error
        UserController --> UI: 404 Not Found
    else Tồn tại
        UserService -> UserRepository: Kiểm tra email trùng
        UserRepository -> DB: SELECT user by email
        DB --> UserRepository

        alt Email đã tồn tại (khác user hiện tại)
            UserRepository --> UserService: Error (duplicate)
            UserService --> UserController: Error
            UserController --> UI: Email đã tồn tại
        else Hợp lệ
            alt Có thay đổi password
                UserService -> UserService: Hash password
            end

            UserService -> UserRepository: Update user
            UserRepository -> DB: UPDATE user
            DB --> UserRepository: OK

            UserRepository --> UserService: Success
            UserService --> UserController: Success
            UserController --> UI: Cập nhật thành công
        end
    end
end

@enduml