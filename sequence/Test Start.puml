@startuml test start
title Student Take Test — Sequence Diagram

actor Student

boundary "TestTakePage" as UI

control "TestController" as Controller
control "TestService" as Service
control "AttemptRepository" as Repo

entity "TestAttempt" as Attempt
entity "MySQL" as DB

== Validate Test Code ==

Student -> UI: Enter test code
UI -> Controller: validateTestCode(code)

Controller -> Service: validateTestCode(code)

alt Invalid code
    Service --> Controller: validation failed
    Controller --> UI: show error message

else Valid code

    Service -> Repo: createAttempt(userId, testId)

    Repo -> Attempt: create()
    Attempt -> DB: INSERT attempt
    DB --> Attempt: attempt_id

    Attempt --> Repo: AttemptEntity
    Repo --> Service: AttemptEntity

    Service --> Controller: attempt created
    Controller --> UI: render questions

end

@enduml
