@startuml import_question_sequence
title Sequence Diagram - Import Question from CSV/Excel

actor Teacher
participant QuestionController
participant FileService
participant QuestionService
participant QuestionRepository
database DB

Teacher -> QuestionController: uploadQuestionFile(file)

QuestionController -> FileService: parseFile(file)

FileService -> FileService: detectFormat(file)

alt CSV
    FileService -> FileService: parseCSV(file)
else Excel
    FileService -> FileService: parseExcel(file)
end

FileService --> QuestionController: parsed_data

QuestionController -> QuestionService: importQuestions(parsed_data, subject_id)

loop for each question in parsed_data
    QuestionService -> QuestionService: validateQuestion(question)
    
    alt invalid
        QuestionService --> QuestionController: Error - invalid data
    else valid
        QuestionService -> QuestionRepository: createQuestion(question)
        QuestionRepository -> DB: INSERT question
        DB --> QuestionRepository: question_id
        QuestionRepository --> QuestionService: question_id
    end
end

QuestionService --> QuestionController: {imported_count, failed_count}
QuestionController --> Teacher: result_message

@enduml
