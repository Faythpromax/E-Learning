@startuml gamification_sequence
title Sequence Diagram - Gamification (XP, Level, Badge)

actor Student
participant PracticeController
participant PracticeService
participant GamificationService
participant StudentRepository
participant AchievementRepository
database DB

Student -> PracticeController: submitAnswer(user_id, question_id, answer)

PracticeController -> PracticeService: submit(user_id, question_id, answer)

PracticeService -> PracticeService: checkAnswer()

alt Đúng
    PracticeService -> GamificationService: addXP(user_id, xp_points)
    
    GamificationService -> StudentRepository: getXP(user_id)
    StudentRepository -> DB: SELECT xp
    DB --> StudentRepository: current_xp
    StudentRepository --> GamificationService: current_xp

    GamificationService -> StudentRepository: updateXP(user_id, new_xp)
    StudentRepository -> DB: UPDATE user xp

    GamificationService -> GamificationService: calculateLevel(new_xp)

    alt levelUp
        GamificationService -> StudentRepository: updateLevel(user_id, new_level)
        StudentRepository -> DB: UPDATE user level
    end

    GamificationService -> GamificationService: checkBadges(user_id)

    alt đạt yêu cầu badge
        GamificationService -> AchievementRepository: addBadge(user_id, badge_id)
        AchievementRepository -> DB: INSERT user_achievement
    end

    GamificationService --> PracticeService: {xp, level, badge}
else Sai
    PracticeService --> PracticeController: {result, no_xp}
end

PracticeService --> PracticeController: result
PracticeController --> Student: {is_correct, xp, level, badge}

@enduml
