@startuml dashboard_teacher_sequence
title Sequence Diagram - Teacher Dashboard

actor Teacher
participant DashboardController
participant DashboardService
participant StudentRepository
participant QuestionProgressRepository
participant TestAttemptRepository
database DB

Teacher -> DashboardController: viewDashboard(teacher_id)

DashboardController -> DashboardService: getDashboardData(teacher_id)

' ===== Top Students =====
DashboardService -> TestAttemptRepository: getTopStudents(teacher_id)
TestAttemptRepository -> DB: SELECT students ORDER BY score DESC
DB --> TestAttemptRepository: top_students
TestAttemptRepository --> DashboardService: top_students

' ===== Question Performance =====
DashboardService -> QuestionProgressRepository: getQuestionStats(teacher_id)
QuestionProgressRepository -> DB: SELECT question_progress stats
DB --> QuestionProgressRepository: stats
QuestionProgressRepository --> DashboardService: stats

' ===== Weak Areas by Class =====
DashboardService -> TestAttemptRepository: getClassPerformance(teacher_id)
TestAttemptRepository -> DB: SELECT test_attempts by class
DB --> TestAttemptRepository: class_performance
TestAttemptRepository --> DashboardService: class_performance

DashboardService -> DashboardService: aggregateData(all_data)

DashboardService --> DashboardController: {top_students, question_stats, class_performance}
DashboardController --> Teacher: dashboard_view

@enduml
