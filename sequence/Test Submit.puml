@startuml student submit test
title Student Submit Test — Sequence Diagram

actor Student <<actor>>
boundary "TestSubmitPage" as UI <<boundary>>
control "TestController" as Controller <<control>>
control "TestService" as Service <<control>>
control "ScoringFactory" as Factory <<control>>
control "ScoringStrategy" as Strategy <<control>>
control "AttemptRepository" as Repo <<control>>
entity "TestAttempt" as Attempt <<entity>>
database "MySQL" as DB <<entity>>

UI -> Controller: POST /tests/{id}/submit
Controller -> Controller: validate(submitRequest)
alt validation fails
  Controller --> UI: 422 ValidationErrors
else
  Controller -> Service: submitAttempt(submitRequest)
  Service -> Factory: createScoringStrategy(testSettings)
  Factory --> Strategy: strategy
  Service -> Strategy: calculateScore(answers)
  Strategy --> Service: scoreResult
  Service -> Repo: updateAttemptScore(attemptId, scoreResult)
  Repo -> DB: UPDATE attempt
  Attempt --> Repo: OK
  Repo --> Service: updatedAttempt
  Service --> Controller: 200 SubmissionResult
  Controller --> UI: show results
end

@enduml