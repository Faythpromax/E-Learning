@startuml class_diagram
left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle

scale 1.5
title E-Learning System - Class Diagram

!define ABSTRACT abstract
!define INTERFACE interface

' ============================================
' BACKEND - MODELS (Laravel Eloquent Models)
' ============================================
package "Backend::Models" {
  class User {
    -id: int
    -name: string
    -email: string
    -password: string
    -xp: int
    -level: int
    -email_verified_at: datetime
    -created_at: datetime
    -updated_at: datetime
    +tests(): HasMany
    +attempts(): HasMany
    +questionProgress(): HasMany
  }

  class Test {
    -id: int
    -title: string
    -description: string
    -duration_minutes: int
    -is_published: boolean
    -settings: array
    -created_at: datetime
    -updated_at: datetime
    +questions(): BelongsToMany
    +attempts(): HasMany
  }

  class Question {
    -id: int
    -type: string
    -content: string
    -data: array
    -explanation: string
    -created_at: datetime
    -updated_at: datetime
    +tests(): BelongsToMany
    +answers(): HasMany
    +progresses(): HasMany
  }

  class TestAttempt {
    -id: int
    -test_id: int
    -user_id: int
    -started_at: datetime
    -finished_at: datetime
    -score: decimal
    -status: string
    -metadata: array
    -created_at: datetime
    -updated_at: datetime
    +test(): BelongsTo
    +user(): BelongsTo
    +answers(): HasMany
  }

  class TestAnswer {
    -id: int
    -test_attempt_id: int
    -question_id: int
    -answer: array
    -is_correct: boolean
    -score: decimal
    -metadata: array
    -created_at: datetime
    -updated_at: datetime
    +attempt(): BelongsTo
    +question(): BelongsTo
  }

  class QuestionProgress {
    -id: int
    -question_id: int
    -user_id: int
    -status: string
    -attempts: int
    -last_answer: array
    -last_viewed_at: datetime
    -last_attempt_at: datetime
    -is_correct: boolean
    -data: array
    -created_at: datetime
    -updated_at: datetime
    +question(): BelongsTo
    +user(): BelongsTo
  }
}

' ============================================
' BACKEND - SERVICES
' ============================================
package "Backend::Services" {
  class GamificationService {
    +XP_PER_CORRECT: int = 10
    +XP_PER_PERFECT_DAY: int = 100
    +XP_PER_STREAK: int = 5
    +LEVEL_THRESHOLDS: array
    +addXP(userId: int, xpPoints: int): array
    +calculateLevel(xp: int): int
    +checkAndAwardBadges(userId: int, questionAnswered: bool): array
    +awardBadge(userId: int, code: string, name: string): Badge
  }

  class AdaptiveLearningService {
    +analyzeWeakAreas(userId: int): Collection
    +getNextRecommendedQuestion(userId: int, limit: int): Collection
    +calculateQuestionFrequency(userId: int, questionId: int): float
  }

  class NotificationService {
    +notifyStudentNewTest(userId: int, testId: int): void
    +notifyTeacherTestCompleted(testId: int, userId: int): void
    +notifyStudentTestDue(userId: int, testId: int, dueDate: datetime): void
    +sendNotification(userId: int, message: string): void
  }

  class TestService {
    +createTest(data: array): Test
    +updateTest(testId: int, data: array): Test
    +publishTest(testId: int): Test
    +getTestStatistics(testId: int): array
    +calculateTestScore(attemptId: int): decimal
  }

  class QuestionService {
    +createQuestion(data: array): Question
    +updateQuestion(questionId: int, data: array): Question
    +deleteQuestion(questionId: int): boolean
    +validateQuestion(data: array): boolean
  }

  class PracticeService {
    +getPracticeQuestions(userId: int, limit: int): Collection
    +recordPracticeAnswer(userId: int, questionId: int, answer: array): QuestionProgress
    +getStudentPracticeStats(userId: int): array
  }

  class ReviewAnswerService {
    +getAttemptReview(attemptId: int): array
    +getDetailedAnswerReview(answerId: int): array
    +getProgressStatistics(userId: int): array
  }

  class AutoSubmitTestService {
    +checkExpiredAttempts(): void
    +autoSubmitAttempt(attemptId: int): TestAttempt
    +isTimeExpired(attemptId: int): boolean
  }

  class AntiCheatDetectionService {
    +detectTabSwitch(attemptId: int): boolean
    +detectCopyAttempt(attemptId: int): boolean
    +recordUserBehavior(attemptId: int, behavior: array): void
    +flagSuspiciousActivity(attemptId: int): void
  }

  class ProgressChartService {
    +getPracticeProgress(userId: int, days: int): array
    +getTestPerformance(userId: int, days: int): array
    +getOverallStatistics(userId: int): array
  }

  class DashboardTeacherService {
    +getTopStudents(classId: int, limit: int): Collection
    +getQuestionStatistics(testId: int): array
    +getClassPerformance(classId: int): array
    +getDashboardStats(): array
  }

  class AISuggestQuestionService {
    +suggestQuestionsForWeakAreas(userId: int, limit: int): Collection
    +suggestDifficultyProgression(userId: int): array
  }

  class RandomQuestionService {
    +shuffleTestQuestions(testId: int): Collection
    +shuffleAnswerOptions(questionId: int): array
  }
}

' ============================================
' BACKEND - RELATIONSHIPS
' ============================================
User "1" -- "*" TestAttempt
User "1" -- "*" QuestionProgress
Test "1" -- "*" TestAttempt
Test "*" -- "*" Question
Question "1" -- "*" TestAnswer
Question "1" -- "*" QuestionProgress
TestAttempt "1" -- "*" TestAnswer
TestAttempt "*" -- "1" User

