package Controllers {
  class AuthController {
    +login()
    +logout()
    +register()
    +verifyEmail()
  }

  class PracticeController {
    -practiceService: PracticeService
    +index()
    +getQuestion()
    +submitAnswer()
    +getProgress()
  }

  class QuestionController {
    -questionService: QuestionService
    +index()
    +show(id)
    +store(data)
    +update(id, data)
    +destroy(id)
    +search(query)
  }

  class TestController {
    -testService: TestService
    +index()
    +show(id)
    +store(data)
    +start(testId)
    +submit(testId, answers)
    +getResults(testId)
  }

  class ClassController {
    -classService: ClassService
    +index()
    +show(id)
    +store(data)
    +update(id, data)
    +destroy(id)
    +addStudent(classId, userId)
    +removeStudent(classId, userId)
    +uploadMaterial(classId, file)
  }
}

package Services {
  class PracticeService {
    -questionRepository: QuestionRepository
    -progressRepository: QuestionProgressRepository
    -scoringFactory: ScoringFactory
    +getRandomQuestion(subject, difficulty)
    +submitAnswer(userId, questionId, answer)
    +getUserProgress(userId)
    +updateProgress(userId, questionId, isCorrect)
  }

  class QuestionService {
    -questionRepository: QuestionRepository
    +getAll(filters)
    +find(id)
    +create(data)
    +update(id, data)
    +delete(id)
    +search(query)
    +validate(data)
  }

  class TestService {
    -testRepository: TestRepository
    -attemptRepository: TestAttemptRepository
    +searchTests(query)
    +startTest(userId, testId)
    +submitTest(userId, testId, answers)
    +getTestResults(attemptId)
    +calculateScore(attempt)
  }

  class ClassService {
    -classRepository: ClassRepository
    +getAll()
    +find(id)
    +create(data)
    +update(id, data)
    +delete(id)
    +addStudent(classId, userId)
    +removeStudent(classId, userId)
    +getClassStudents(classId)
  }

  class AdaptiveLearningService {
    +suggestNextQuestion(userId)
    +adjustDifficulty(userId, performance)
    +getRecommendations(userId)
  }

  class AISuggestQuestionService {
    +suggestQuestions(userId, topic)
    +rankQuestions(questions)
  }

  class AntiCheatDetectionService {
    +detectAnomalies(attemptId)
    +flagSuspiciousActivity(attemptId)
    +reportCheating(attemptId)
  }

  class AuthService {
    +authenticate(email, password)
    +authorize(user, action)
    +generateToken(user)
  }

  class AutoSubmitTestService {
    +scheduleAutoSubmit(attemptId, duration)
    +autoSubmitTest(attemptId)
  }

  class GamificationService {
    +calculatePoints(userId, action)
    +awardBadge(userId, badge)
    +getLeaderboard()
  }

  class ImportQuestionService {
    +importFromFile(file)
    +parseQuestions(data)
    +validateImport()
  }

  class NotificationService {
    +sendNotification(userId, message)
    +sendEmail(email, subject, body)
    +broadcastMessage(classId, message)
  }

  class ProgressChartService {
    +generateChart(userId)
    +getProgressData(userId)
    +exportChart(userId, format)
  }

  class RandomQuestionService {
    +getRandomQuestions(count, filters)
    +generateRandomTest(config)
  }

  class ReviewAnswerService {
    +getReview(attemptId)
    +getAnswerExplanation(questionId)
    +getDetailedFeedback(attemptId)
  }

  class DashboardTeacherService {
    +getStudentProgress(classId)
    +getClassStatistics(classId)
    +generateReport(classId)
  }
}

package Repositories {
  interface QuestionRepositoryInterface {
    +getAll()
    +search(query)
    +getRandom()
    +find(id)
    +create(data)
    +update(id, data)
    +delete(id)
  }

  class QuestionRepository {
    +getAll()
    +search(query)
    +getRandom()
    +find(id)
    +create(data)
    +update(id, data)
    +delete(id)
  }

  interface QuestionProgressRepositoryInterface {
    +saveOrUpdate(data)
    +getByUserId(userId)
  }

  class QuestionProgressRepository {
    +saveOrUpdate(data)
    +getByUserId(userId)
  }

  interface TestRepositoryInterface {
    +search(query)
    +find(id)
    +findAttempt(userId, testId)
    +createAttempt(data)
    +saveAnswer(data)
    +updateAttempt(id, data)
  }

  class TestRepository {
    +search(query)
    +find(id)
    +findAttempt(userId, testId)
    +createAttempt(data)
    +saveAnswer(data)
    +updateAttempt(id, data)
  }

  interface ClassRepositoryInterface {
    +getAll()
    +find(id)
    +create(data)
    +update(id, data)
    +delete(id)
  }

  class ClassRepository {
    +getAll()
    +find(id)
    +create(data)
    +update(id, data)
    +delete(id)
    +getStudents(classId)
  }
}

package Strategies {
  interface ScoringStrategyInterface {
    +check(question, answer): bool
    +score(question, answer): float
  }

  class MCQStrategy {
    +check(question, answer): bool
    +score(question, answer): float
  }

  class FillBlankStrategy {
    +check(question, answer): bool
    +score(question, answer): float
  }

  class EssayStrategy {
    +check(question, answer): bool
    +score(question, answer): float
  }

  class ScoringFactory {
    +make(type): ScoringStrategyInterface
  }
}

package UI {
  class PracticeScreen {
    -currentQuestion: Question
    -userAnswer: string
    -progress: number
    +displayQuestion()
    +submitAnswer()
    +showFeedback()
    +nextQuestion()
  }

  class TestScreen {
    -currentTest: Test
    -answers: map
    -timer: number
    +displayTest()
    +displayQuestion()
    +submitAnswer()
    +submitTest()
    +updateTimer()
  }

  class Dashboard {
    +displayStats()
    +displayCharts()
    +showClasses()
  }
}

