@startuml auto_submit_test_sequence
title Sequence Diagram - Auto Submit Test When Time Expired

actor Student
participant TestController
participant SchedulerService
participant TestService
participant TestRepository
participant ScoringStrategy
entity "Test" as test
database DB

Student -> TestController: startTest(user_id, test_id)
TestController -> TestService: createAttempt(user_id, test_id)
TestService -> TestRepository: insertAttempt(user_id, test_id, duration)
TestRepository -> test: Khởi tạo/Gán dữ liệu

TestRepository -> DB: INSERT test_attempt
DB --> TestRepository: attempt_id
TestRepository --> TestService: attempt_id
TestService --> TestController: {attempt_id, expired_at}
TestController --> Student: test started

' ===== Scheduler Check =====
SchedulerService -> SchedulerService: checkExpiredTests()

loop every minute
    SchedulerService -> TestRepository: getExpiredAttempts()
    TestRepository -> DB: SELECT test_attempt WHERE expired_at < NOW()
    DB --> TestRepository: expired_attempts
TestRepository -> test: Khởi tạo đối tượng (Map)
test --> TestRepository: Đối tượng Test
    TestRepository --> SchedulerService: expired_attempts

    alt có expired attempts
        loop for each expired attempt
            SchedulerService -> TestService: autoSubmit(attempt_id)
            TestService -> TestRepository: findAttempt(attempt_id)
            TestRepository -> DB: SELECT test_attempt
            DB --> TestRepository: attempt_data
TestRepository -> test: Khởi tạo đối tượng (Map)
test --> TestRepository: Đối tượng Test

            TestService -> TestRepository: getAnswers(attempt_id)
            TestRepository -> DB: SELECT test_answers
            DB --> TestRepository: answers
TestRepository -> test: Khởi tạo đối tượng (Map)
test --> TestRepository: Đối tượng Test

            loop for each answer
                TestService -> ScoringStrategy: scoreAnswer(answer)
                ScoringStrategy --> TestService: score
            end

            TestService -> TestRepository: updateAttemptScore(attempt_id, total_score, submitted_at)
            TestRepository -> test: Cập nhật thuộc tính (Fill)

            TestRepository -> DB: UPDATE test_attempt
        end
    end
end

@enduml
