@startuml admin_search_user
title Sequence Diagram - Admin Search User

actor "Admin" as admin
boundary "AdminUserSearchPage" as UI
control "AdminUserController" as controller
control "UserService" as service
control "UserRepositoryInterface" as repository
entity "User" as user
database "Database" as db

admin -> UI: 1: Nhập từ khóa tìm kiếm
UI -> controller: 1.1: GET /admin/users?query={keyword}&role={role}&status={status}
activate controller

controller -> controller++: 1.1.1: validate(SearchUserRequest)
controller --> controller--: Kết quả validate

alt Dữ liệu nhập vào không hợp lệ
    controller --> UI: 1.1.2: 422 Validation Errors
    UI --> admin: Hiển thị lỗi nhập liệu
else Dữ liệu hợp lệ
    controller -> service: 1.1.3: searchUsers(array $filters)
    activate service
    
    service -> repository: 1.1.3.1: search(array $filters)
    activate repository
    
    repository -> db: 1.1.3.1.1: SELECT * FROM users\nWHERE name LIKE ? OR email LIKE ?\nAND role = ?\nAND status = ?\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
    db --> repository: User data rows
    
    alt Không tìm thấy kết quả
        repository --> service: []
        deactivate repository
        service --> controller: []
        deactivate service
        controller --> UI: 1.1.3.2: 200 OK {data: [], message: 'Không tìm thấy người dùng'}
        UI --> admin: Hiển thị thông báo không có kết quả
    else Có kết quả
        loop for each user row
            repository -> user: 1.1.3.1.2: Khởi tạo User entity
            activate user
            user --> repository: User object
            deactivate user
        end
        
        repository --> service: 1.1.3.1.3: Collection<User>
        deactivate repository
        
        service --> controller: 1.1.3.2: User list with pagination
        deactivate service
        
        controller --> UI: 1.1.4: 200 OK {data: users, meta: {total, per_page, current_page}}
        deactivate controller
        
        UI --> admin: 1.1.5: Hiển thị danh sách người dùng
    end
end

@enduml