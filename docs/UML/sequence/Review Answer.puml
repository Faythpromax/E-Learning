@startuml review_answer_sequence
title Sequence Diagram - Student Review Test Answers

actor Student
participant TestController
participant TestService
participant TestRepository
participant QuestionRepository
entity "Question" as question
database DB

Student -> TestController: viewTestResult(user_id, test_id)

TestController -> TestService: getTestReview(user_id, test_id)

TestService -> TestRepository: findAttempt(user_id, test_id)
TestRepository -> DB: SELECT test_attempt
DB --> TestRepository: attempt_data
TestRepository --> TestService: attempt_data

TestService -> TestRepository: getAnswers(attempt_id)
TestRepository -> DB: SELECT test_answers
DB --> TestRepository: answers
TestRepository --> TestService: answers

TestService -> QuestionRepository: getQuestions(answer_list)
QuestionRepository -> DB: SELECT questions
DB --> QuestionRepository: questions
QuestionRepository -> question: Khởi tạo đối tượng (Map)
question --> QuestionRepository: Đối tượng Question
QuestionRepository --> TestService: questions

TestService -> TestService: buildReview(answers, questions)

loop for each answer
    TestService -> TestService: matchAnswer(answer, question, correct_answer)
end

TestService --> TestController: {score, questions, answers, explanations}
TestController --> Student: review_view

@enduml
