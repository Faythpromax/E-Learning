@startuml teacher upload material
title Teacher Upload Material — Sequence Diagram

actor Teacher <<actor>>
boundary "UploadMaterialPage" as UI <<boundary>>
control "MaterialController" as Controller <<control>>
control "MaterialService" as Service <<control>>
control "MaterialRepository" as Repository <<control>>
entity "ClassMaterial" as classmaterial
database "MySQL" as DB <<entity>>

Teacher -> UI: Open upload dialog and submit file
UI -> Controller: POST /materials (UploadMaterialRequest)
Controller -> Controller: validate(request, file)
alt validation fails
	Controller --> UI: 422 ValidationErrors
else
	Controller -> Service: storeMaterial(validRequest)
 Service -> Repository: saveMetadata(metadata)
 Repository -> classmaterial: Khởi tạo/Gán dữ liệu

	Repository -> DB: INSERT material
	Repository --> Service: MaterialEntity
	Service -> Service: storeFileToStorage(file)
	Service --> Controller: 201 Created {id, url}
	Controller --> UI: Show success and URL
end

@enduml