@startuml practice_management_class_diagram
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0

title Class Diagram - Practice Management (SOLID / Layered Architecture)

' ==================== LAYER 1: PRESENTATION LAYER ====================
package "Presentation Layer" {
    class PracticeScreen <<boundary>> {
        +questionsList: Array
        +renderQuestions(): void
        +handleAnswerSubmit(): void
    }

    class PracticeController <<controller>> {
        -practiceService: IPracticeService
        +getPractice(userId: int, params: array): JsonResponse
        +submitAnswer(request: AnswerRequest): JsonResponse
    }
}

' ==================== LAYER 2: BUSINESS LOGIC LAYER ====================
package "Business Logic Layer" {
    interface IPracticeService <<service interface>> {
        +getPracticeQuestions(userId: int, params: array): Collection
        +recordPracticeAnswer(userId: int, questionId: int, answer: String): QuestionProgress
    }

    class PracticeService <<service>> {
        -questionRepository: IQuestionRepository
        -progressRepository: IProgressRepository
        +getPracticeQuestions(userId: int, params: array): Collection
        +recordPracticeAnswer(userId: int, questionId: int, answer: String): QuestionProgress
    }
}

' ==================== LAYER 3: DATA ACCESS LAYER ====================
package "Data Access Layer" {
    interface IQuestionRepository <<repository interface>> {
        +findForPractice(userId: int, limit: int): Collection
    }

    class QuestionRepository <<repository>> {
        +findForPractice(userId: int, limit: int): Collection
    }

    interface IProgressRepository <<repository interface>> {
        +upsertProgress(userId: int, questionId: int, answer: String): QuestionProgress
    }

    class ProgressRepository <<repository>> {
        +upsertProgress(userId: int, questionId: int, answer: String): QuestionProgress
    }
}

' ==================== LAYER 4: DATA TRANSFER OBJECTS (DTO) ====================
package "Data Transfer Objects (DTO)" {
    class AnswerRequest <<dto>> {
        +userId: int
        +questionId: int
        +answer: String
    }
}

' ==================== LAYER 5: DOMAIN ENTITIES ====================
package "Domain Entities" {
    class Question <<entity>> {
        -id: int
        -content: string
        -options: array
        -correct_answer: string
        +progressions(): HasMany
    }

    class QuestionProgress <<entity>> {
        -id: int
        -user_id: int
        -question_id: int
        -last_answer: string
        -is_correct: bool
        -updated_at: DateTime
    }
}

' ==================== RELATIONSHIPS & DEPENDENCIES ====================

' UI Layer to Controller & DTO
PracticeScreen ..> AnswerRequest : constructs
PracticeScreen --> PracticeController : calls

' Controller Layer to Service & DTOs
PracticeController --> IPracticeService : injects
PracticeController ..> AnswerRequest : dependency

' Service Layer implements Interface & depends on Repositories
PracticeService .up.|> IPracticeService : implements
PracticeService --> IQuestionRepository : injects
PracticeService --> IProgressRepository : injects
PracticeService ..> AnswerRequest : dependency

' Data Access Layer implements Interfaces
QuestionRepository .up.|> IQuestionRepository : implements
ProgressRepository .up.|> IProgressRepository : implements

' Repositories dependencies with Entities (Nét đứt chuẩn UML)
QuestionRepository ..> Question : retrieves
ProgressRepository ..> QuestionProgress : updates/saves

' Entity Relationships
Question "1" *-- "0..*" QuestionProgress : contains

@enduml