@startuml classroom_management_class_diagram
skinparam componentStyle rectangle
skinparam classAttributeIconSize 0

title Class Diagram - Classroom Management (SOLID / Layered Architecture)

' ==================== LAYER 1: PRESENTATION LAYER ====================
package "Presentation Layer" {
    class ClassListPage <<boundary>> {
        +classesList: Array
        +renderList(): void
        +handleEnrollStudent(): void
    }

    class ClassController <<controller>> {
        -classService: IClassService
        +getClasses(): JsonResponse
        +addStudent(classId: int, request: AddStudentRequest): JsonResponse
    }
}

' ==================== LAYER 2: BUSINESS LOGIC LAYER ====================
package "Business Logic Layer" {
    interface IClassService <<service interface>> {
        +listClasses(): Collection
        +addStudentToClass(classId: int, studentData: AddStudentRequest): bool
    }

    class ClassService <<service>> {
        -classRepository: IClassRepository
        -classStudentRepository: IClassStudentRepository
        +listClasses(): Collection
        +addStudentToClass(classId: int, studentData: AddStudentRequest): bool
    }
}

' ==================== LAYER 3: DATA ACCESS LAYER ====================
package "Data Access Layer" {
    interface IClassRepository <<repository interface>> {
        +findAll(): Collection
    }

    class ClassRepository <<repository>> {
        +findAll(): Collection
    }

    interface IClassStudentRepository <<repository interface>> {
        +createEnrollment(classId: int, studentId: int): ClassStudent
    }

    class ClassStudentRepository <<repository>> {
        +createEnrollment(classId: int, studentId: int): ClassStudent
    }
}

' ==================== LAYER 4: DATA TRANSFER OBJECTS (DTO) ====================
package "Data Transfer Objects (DTO)" {
    class AddStudentRequest <<dto>> {
        +student_id: int
    }
}

' ==================== LAYER 5: DOMAIN ENTITIES ====================
package "Domain Entities" {
    class ClassRoom <<entity>> {
        -id: int
        -name: string
        -description: string
        +students(): BelongsToMany
    }

    class User <<entity>> {
        -id: int
        -name: string
        -email: string
        -role: string
    }

    class ClassStudent <<entity>> {
        -id: int
        -class_id: int
        -user_id: int
        -enrolled_at: DateTime
    }
}

' ==================== RELATIONSHIPS & DEPENDENCIES ====================

' UI Layer to Controller & DTO
ClassListPage ..> AddStudentRequest : constructs
ClassListPage --> ClassController : calls

' Controller Layer to Service & DTOs
ClassController --> IClassService : injects
ClassController ..> AddStudentRequest : dependency

' Service Layer implements Interface & depends on Repositories
ClassService .up.|> IClassService : implements
ClassService --> IClassRepository : injects
ClassService --> IClassStudentRepository : injects
ClassService ..> AddStudentRequest : dependency

' Data Access Layer implements Interfaces
ClassRepository .up.|> IClassRepository : implements
ClassStudentRepository .up.|> IClassStudentRepository : implements

' Repositories dependencies with Entities (Nét đứt chuẩn UML)
ClassRepository ..> ClassRoom : retrieves
ClassStudentRepository ..> ClassStudent : creates

' Entity Relationships (Many-to-Many Breakdown using Association)
ClassRoom "1" *-- "0..*" ClassStudent : contains
User "1" *-- "0..*" ClassStudent : registers

@enduml